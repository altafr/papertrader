{
  "name": "momentum-autopilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Paper-only momentum trading operations platform.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "audit:secret-surfaces": "bash scripts/audit-secret-surfaces.sh",
    "dev:api": "pnpm --filter @momentum/api dev",
    "dev:web": "pnpm --filter @momentum/web dev",
    "dev:worker": "pnpm --filter @momentum/worker dev",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:operator-auth-boundary": "tsx scripts/verify-operator-auth-boundary.ts",
    "verify:operator-overview": "tsx scripts/verify-operator-overview.ts",
    "verify:paper-runtime": "tsx scripts/verify-paper-runtime.ts",
    "verify:public-surface": "tsx scripts/verify-public-surface.ts",
    "verify:hosted": "tsx scripts/verify-hosted.ts",
    "verify:telegram-mini-app": "tsx scripts/verify-telegram-mini-app.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
