{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @momentum/${SERVICE_KIND:?SERVICE_KIND is required} build"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "pnpm --filter @momentum/${SERVICE_KIND:?SERVICE_KIND is required} start"
  }
}
