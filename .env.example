# Non-secret paper-only defaults. Keep this file free of real credentials.
APP_ENVIRONMENT=production-paper
TRADING_MODE=paper
BROKER_CONNECTION_ENABLED=false
ALPACA_PAPER_TRADE=true

# Telegram alert channel. Keep disabled until the guarded channel test passes.
# TELEGRAM_ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=<Telegram bot token; Railway worker only>
# TELEGRAM_CHAT_ID=<Telegram numeric chat ID; Railway worker only>
# FIRECRAWL_API_KEY=<optional server-side web research key; Railway worker only>

# Set these only in Railway API and worker service variables, then seal them.
# ALPACA_API_KEY=<paper API key ID>
# ALPACA_SECRET_KEY=<paper API secret>

# Optional least-privilege MCP configuration belongs in the MCP client only.
# ALPACA_TOOLSETS=account,assets,stock-data,crypto-data,news,watchlists

# Clerk: publishable key on Vercel; the remaining values belong only in Railway API/worker variables.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<Clerk publishable key>
# NEXT_PUBLIC_API_BASE_URL=https://your-railway-api.example

# Credential-free hosted runtime verification (used by pnpm verify:paper-runtime).
# PAPERTRADER_WORKER_HEALTH_URL=https://your-worker-domain.example/health
# PAPERTRADER_API_HEALTH_URL=https://your-api-domain.example/health
# Optional: require the Worker to report this exact non-secret source revision.
# PAPERTRADER_EXPECTED_RELEASE=
# The verifier retries transient startup health convergence up to four times.

# Optional supervised paper market stream. Disabled unless explicitly enabled.
# MARKET_STREAM_ENABLED=false
# MARKET_STREAM_ASSET_CLASS=us_equity
# MARKET_STREAM_SYMBOLS=AAPL,MSFT
# MARKET_STREAM_TIMEFRAME=1Min
# ALPACA_STOCK_FEED=iex
# CLERK_PUBLISHABLE_KEY=<Clerk publishable key>
# CLERK_SECRET_KEY=<Clerk secret key>
# CLERK_OPERATOR_USER_ID=<exact Clerk user ID allowlisted for this application>
# CLERK_AUTHORIZED_PARTIES=https://your-vercel-domain.example

# Optional PostgreSQL-backed durable daily queue. Disabled by default until its
# daily preparation handler and hosted verification are approved.
# DURABLE_SCHEDULER_ENABLED=false
# DAILY_PREPARATION_HANDLER_ENABLED=false
# DAILY_PREPARATION_CRON=0 0 * * *
# DAILY_PREPARATION_RETRY_LIMIT=3
# DAILY_PREPARATION_RETRY_DELAY_SECONDS=60

# One-shot guarded Railway command for installing/verifying pg-boss tables and
# queue definitions. Never set this as a persistent service variable.
# DURABLE_QUEUE_MIGRATE=false
# One-shot guarded verification command; never set persistently.
# DURABLE_QUEUE_STATUS=false
# One-shot guarded enqueue for immediate hosted reconciliation verification.
# DURABLE_QUEUE_RUN_ONCE=false
# One-shot guarded application schema migration; never set persistently.
# DATABASE_MIGRATE=false
# Optional fixed quantities are intentionally omitted: leaving these unset
# enables dynamic sizing at the required minimum 2% of current equity.
